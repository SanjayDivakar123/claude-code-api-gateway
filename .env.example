PORT=8787

# "api" uses ANTHROPIC_API_KEY. "subscription" invokes Claude Code non-interactively.
CLAUDE_PROVIDER=subscription

# Your platform calls this gateway with:
# Authorization: Bearer <GATEWAY_API_KEY>
GATEWAY_API_KEY=replace-with-a-long-random-secret

# Required only when CLAUDE_PROVIDER=api.
# Server-side Anthropic API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Required for subscription mode in hosted/CI environments unless the host is
# already logged in with Claude Code. Generate with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=your-approved-claude-code-oauth-token

# Optional overrides
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
DEFAULT_MODEL=claude-sonnet-5
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_CWD=/var/lib/llm-runtime
CLAUDE_CONFIG_DIR=/var/lib/llm-runtime/claude-config
MAX_CONCURRENT_CLAUDE_RUNS=2
REQUEST_TIMEOUT_MS=600000

# Optional: lets /login save CLAUDE_CODE_OAUTH_TOKEN and restart under systemd.
ALLOW_WEB_TOKEN_SETUP=false
GATEWAY_ENV_FILE=/etc/claude-api-gateway.env
